# ========== 服务配置 ==========
NODE_ENV=production
PORT=3456
HOST=0.0.0.0

# ========== 域名（deploy.sh 自动配置 Nginx + HTTPS） ==========
# 必填：你的 API 子域名（不带 https:// 前缀）
# 例：mahjong.athenaquant.com.cn
API_DOMAIN=

# Let's Encrypt 申请证书时的邮箱（用于过期提醒）
# 例：admin@athenaquant.com.cn
CERTBOT_EMAIL=

# ========== JWT 密钥（务必修改） ==========
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=180d

# ========== 数据库 ==========
# SQLite 文件路径（相对于 server 目录）

# ----- MySQL（mysql2；库/账号用 scripts/setup-mysql.sh addapp 创建） -----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mahjong_records
MYSQL_USER=mahjong_rw
MYSQL_PASSWORD=change-me
MYSQL_CONNECTION_LIMIT=10


# ========== 微信小程序（v1 可留空，dev 模式自动放行） ==========
WX_APPID=
WX_SECRET=

# ========== CORS 白名单（多个用逗号分隔，留空则全部放行） ==========
CORS_ORIGIN=

# ========== 日志 ==========
LOG_LEVEL=info
LOG_FILE=./data/app.log

# ========== 限流（每 IP 每分钟请求数） ==========
RATE_LIMIT_PER_MIN=120

# ========== 免费 / 付费分层 ==========
# 免费用户云端保留「几个有数据的日期」（不是自然日）。
# 例：设为 3 时，用户 2.3 / 2.5 / 2.10 / 2.22 有数据 → 云端只留 2.5 / 2.10 / 2.22。
FREE_WINDOW_DATES=3

# 统计「日期」用的时区偏移（分钟）。480 = UTC+8。
# 不要改成服务器本地时区 —— 线上机器可能跑在 UTC，
# 按 UTC 切日期会把晚上 8 点后的牌局算到第二天，窗口边界就错位了。
TZ_OFFSET_MINUTES=480

# ========== 虚拟支付（wx.requestVirtualPayment） ==========
# MP 后台 → 支付与交易 → 虚拟支付 → 基本配置
VPAY_OFFER_ID=1450649440

# 沙箱 AppKey（联调用，配合 VPAY_ENV=1）
VPAY_SANDBOX_APP_KEY=16WSLCnFyi2G8mHXkPxvTimiRjRCt6pw

# ⚠️ 现网 AppKey —— 真实收款的签名密钥，泄露即可被伪造支付签名。
# 不进 git：上线前手动填这里（同时把 VPAY_ENV 改为 0）。
VPAY_PROD_APP_KEY=

# 0 = 现网，1 = 沙箱。联调期保持 1。
VPAY_ENV=1

# 道具 productId + 价格（单位：分，1 元 = 100 分）。
# 需在 MP 后台「虚拟支付 → 道具管理」创建同名道具并【手动发布】。
# 安卓/iOS 同价（合规要求），现网价格必须与这里完全一致，否则报 -15003。
# 雀战录只提供一档：终身 9.9 元（990 分）。
VPAY_PRODUCT_LIFETIME=PRO_LIFETIME
VPAY_PRICE_LIFETIME=990
# 历史遗留：年度档 28 元（2800 分）。已下架，仅保留配置便于运维回滚，
# 前端入口已删除，不会被调用。
VPAY_PRODUCT_YEARLY=PRO_YEARLY
VPAY_PRICE_YEARLY=2800

# 消息推送（MP 后台 → 虚拟支付 → 消息推送）：
# 回调 URL 填 https://<API_DOMAIN>/api/vpay/notify，数据格式 JSON，加密方式安全模式。
# 下面两项必须与后台配置完全一致。
VPAY_PUSH_TOKEN=
VPAY_AES_KEY=