# ========== 服务配置 ==========
NODE_ENV=production
PORT=3456
HOST=0.0.0.0

# ========== 域名（deploy.sh 自动配置 Nginx + HTTPS） ==========
# 必填：你的 API 子域名（不带 https:// 前缀）
# 例：mahjong.athenaquant.com.cn
API_DOMAIN=

# Let's Encrypt 申请证书时的邮箱（用于过期提醒）
# 例：admin@athenaquant.com.cn
CERTBOT_EMAIL=

# ========== JWT 密钥（务必修改） ==========
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=180d

# ========== 数据库 ==========
# SQLite 文件路径（相对于 server 目录）
DB_PATH=./data/mahjong.db

# ========== 微信小程序（v1 可留空，dev 模式自动放行） ==========
WX_APPID=
WX_SECRET=

# ========== CORS 白名单（多个用逗号分隔，留空则全部放行） ==========
CORS_ORIGIN=

# ========== 日志 ==========
LOG_LEVEL=info
LOG_FILE=./data/app.log

# ========== 限流（每 IP 每分钟请求数） ==========
RATE_LIMIT_PER_MIN=120

# ========== 免费 / 付费分层 ==========
# 免费用户云端保留「几个有数据的日期」（不是自然日）。
# 例：设为 3 时，用户 2.3 / 2.5 / 2.10 / 2.22 有数据 → 云端只留 2.5 / 2.10 / 2.22。
FREE_WINDOW_DATES=3

# 兑换码 → 升级 Pro。
# ⚠️ 留空时 prod 环境**任何人都无法自助升级**（这是刻意的安全默认值）。
# 个人主体开不了微信支付，所以 MVP 用兑换码跑通「付费 → 解锁」闭环；
# 将来接入支付后，把发码换成支付回调里的 setTier 即可。
PRO_UNLOCK_CODE=

# 统计「日期」用的时区偏移（分钟）。480 = UTC+8。
# 不要改成服务器本地时区 —— 线上机器可能跑在 UTC，
# 按 UTC 切日期会把晚上 8 点后的牌局算到第二天，窗口边界就错位了。
TZ_OFFSET_MINUTES=480